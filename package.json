{
  "name": "metami-att-chat",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "electron:dev": "electron electron/main.mjs",
    "server": "node --experimental-strip-types src/server/main.ts",
    "start": "node --experimental-strip-types src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:server": "node scripts/build-server.mjs",
    "build:electron-dist": "npm run build && npm run build:server && node scripts/stage-electron.mjs",
    "build:license-source-kit": "node scripts/build-license-source-kit.mjs",
    "audit:license-package": "node scripts/audit-license-package.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "^44.5.1",
    "jsdom": "^26.1.0",
    "onnxruntime-node": "1.21.0",
    "typescript": "7.0.2",
    "vite": "8.2.4"
  }
}
